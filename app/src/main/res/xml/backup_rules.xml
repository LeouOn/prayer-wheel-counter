<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Auto-Backup rules for Prayer Wheel Counter (Android 11 and lower).
  Android 12+ uses data_extraction_rules.xml; keep the two files in step.

  Includes:
  - Room database (sessions + lifetime stats): databases/
  - DataStore preferences (settings, saved wheels, achievements):
    files/datastore/

  Everything else under files/ (for example exported CSV/JSON copies) is
  left out on purpose: it is derived from the data above. The app uses no
  SharedPreferences, so the sharedpref domain is not listed.
-->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="file" path="datastore/" />
</full-backup-content>
