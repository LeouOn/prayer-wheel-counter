<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-transfer rules for Android 12+ (API 31+).
  Pre-31 devices use backup_rules.xml; keep the two files in step.

  Includes:
  - Room database (sessions + lifetime stats): databases/
  - DataStore preferences (settings, saved wheels, achievements):
    files/datastore/

  Everything else under files/ (for example exported CSV/JSON copies) is
  left out on purpose: it is derived from the data above.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
